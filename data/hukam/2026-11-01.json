{"date":{"gregorian":{"month":11,"date":1,"year":2026}},"isLatest":null,"shabadIds":[2611],"shabads":[{"shabadInfo":{"shabadId":2611,"pageNo":684,"raag":{"english":"Raag Dhanaasree","unicode":"ਰਾਗੁ ਧਨਾਸਰੀ"},"writer":{"english":"Guru Arjan Dev Ji"}},"verses":[{"verseId":29490,"pageNo":684,"lineNo":3,"verse":{"unicode":"ਧਨਾਸਰੀ ਮਹਲਾ ੫ ॥"},"transliteration":{"english":"dhanaasaree mahalaa panjavaa ||"},"translation":{"en":{"bdb":"Dhanaasaree, Fifth Mehla:"}}},{"verseId":29491,"pageNo":684,"lineNo":4,"verse":{"unicode":"ਤ੍ਰਿਪਤਿ ਭਈ ਸਚੁ ਭੋਜਨੁ ਖਾਇਆ ॥"},"transliteration":{"english":"tirapat bhiee sach bhojan khaiaa ||"},"translation":{"en":{"bdb":"I am satisfied and satiated, eating the food of Truth."}}},{"verseId":29492,"pageNo":684,"lineNo":4,"verse":{"unicode":"ਮਨਿ ਤਨਿ ਰਸਨਾ ਨਾਮੁ ਧਿਆਇਆ ॥੧॥"},"transliteration":{"english":"man tan rasanaa naam dhiaaiaa ||1||"},"translation":{"en":{"bdb":"With my mind, body and tongue, I meditate on the Naam, the Name of the Lord. ||1||"}}},{"verseId":29493,"pageNo":684,"lineNo":4,"verse":{"unicode":"ਜੀਵਨਾ ਹਰਿ ਜੀਵਨਾ ॥"},"transliteration":{"english":"jeevanaa har jeevanaa ||"},"translation":{"en":{"bdb":"Life, spiritual life, is in the Lord."}}},{"verseId":29494,"pageNo":684,"lineNo":5,"verse":{"unicode":"ਜੀਵਨੁ ਹਰਿ ਜਪਿ ਸਾਧਸੰਗਿ ॥੧॥ ਰਹਾਉ ॥"},"transliteration":{"english":"jeevan har jap saadhasa(n)g ||1|| rahaau ||"},"translation":{"en":{"bdb":"Spiritual life consists of chanting the Lord's Name in the Saadh Sangat, the Company of the Holy. ||1||Pause||"}}},{"verseId":29495,"pageNo":684,"lineNo":5,"verse":{"unicode":"ਅਨਿਕ ਪ੍ਰਕਾਰੀ ਬਸਤ੍ਰ ਓਢਾਏ ॥"},"transliteration":{"english":"anik prakaaree basatr oddaae ||"},"translation":{"en":{"bdb":"He is dressed in robes of all sorts,"}}},{"verseId":29496,"pageNo":684,"lineNo":5,"verse":{"unicode":"ਅਨਦਿਨੁ ਕੀਰਤਨੁ ਹਰਿ ਗੁਨ ਗਾਏ ॥੨॥"},"transliteration":{"english":"anadhin keeratan har gun gaae ||2||"},"translation":{"en":{"bdb":"if he sings the Kirtan of the Lord's Glorious Praises, day and night. ||2||"}}},{"verseId":29497,"pageNo":684,"lineNo":6,"verse":{"unicode":"ਹਸਤੀ ਰਥ ਅਸੁ ਅਸਵਾਰੀ ॥"},"transliteration":{"english":"hasatee rath as asavaaree ||"},"translation":{"en":{"bdb":"He rides upon elephants, chariots and horses,"}}},{"verseId":29498,"pageNo":684,"lineNo":6,"verse":{"unicode":"ਹਰਿ ਕਾ ਮਾਰਗੁ ਰਿਦੈ ਨਿਹਾਰੀ ॥੩॥"},"transliteration":{"english":"har kaa maarag ridhai nihaaree ||3||"},"translation":{"en":{"bdb":"if he sees the Lord's Path within his own heart. ||3||"}}},{"verseId":29499,"pageNo":684,"lineNo":6,"verse":{"unicode":"ਮਨ ਤਨ ਅੰਤਰਿ ਚਰਨ ਧਿਆਇਆ ॥"},"transliteration":{"english":"man tan a(n)tar charan dhiaaiaa ||"},"translation":{"en":{"bdb":"Meditating on the Lord's Feet, deep within his mind and body,"}}},{"verseId":29500,"pageNo":684,"lineNo":7,"verse":{"unicode":"ਹਰਿ ਸੁਖ ਨਿਧਾਨ ਨਾਨਕ ਦਾਸਿ ਪਾਇਆ ॥੪॥੨॥੫੬॥"},"transliteration":{"english":"har sukh nidhaan naanak dhaas paiaa ||4||2||56||"},"translation":{"en":{"bdb":"slave Nanak has found the Lord, the treasure of peace. ||4||2||56||"}}}]}],"_archivedAt":"2026-11-07T22:34:37+00:00"}
