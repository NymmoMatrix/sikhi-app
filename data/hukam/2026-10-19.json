{"date":{"gregorian":{"month":10,"date":19,"year":2026}},"isLatest":null,"shabadIds":[2512],"shabads":[{"shabadInfo":{"shabadId":2512,"pageNo":656,"raag":{"english":"Raag Sorath","unicode":"ਰਾਗੁ ਸੋਰਠਿ"},"writer":{"english":"Bhagat Kabeer Ji"}},"verses":[{"verseId":28383,"pageNo":656,"lineNo":9,"verse":{"unicode":"ਸੰਤਹੁ ਮਨ ਪਵਨੈ ਸੁਖੁ ਬਨਿਆ ॥"},"transliteration":{"english":"sa(n)tahu man pavanai sukh baniaa ||"},"translation":{"en":{"bdb":"O Saints, my windy mind has now become peaceful and still."}}},{"verseId":28384,"pageNo":656,"lineNo":10,"verse":{"unicode":"ਕਿਛੁ ਜੋਗੁ ਪਰਾਪਤਿ ਗਨਿਆ ॥ ਰਹਾਉ ॥"},"transliteration":{"english":"kichh jog paraapat ganiaa || rahaau ||"},"translation":{"en":{"bdb":"It seems that I have learned something of the science of Yoga. ||Pause||"}}},{"verseId":28385,"pageNo":656,"lineNo":10,"verse":{"unicode":"ਗੁਰਿ ਦਿਖਲਾਈ ਮੋਰੀ ॥"},"transliteration":{"english":"gur dhikhalaiee moree ||"},"translation":{"en":{"bdb":"The Guru has shown me the hole,"}}},{"verseId":28386,"pageNo":656,"lineNo":10,"verse":{"unicode":"ਜਿਤੁ ਮਿਰਗ ਪੜਤ ਹੈ ਚੋਰੀ ॥"},"transliteration":{"english":"jit mirag paRat hai choree ||"},"translation":{"en":{"bdb":"through which the deer carefully enters."}}},{"verseId":28387,"pageNo":656,"lineNo":11,"verse":{"unicode":"ਮੂੰਦਿ ਲੀਏ ਦਰਵਾਜੇ ॥"},"transliteration":{"english":"moo(n)dh le'ee dharavaaje ||"},"translation":{"en":{"bdb":"I have now closed off the doors,"}}},{"verseId":28388,"pageNo":656,"lineNo":11,"verse":{"unicode":"ਬਾਜੀਅਲੇ ਅਨਹਦ ਬਾਜੇ ॥੧॥"},"transliteration":{"english":"baajeeale anahadh baaje ||1||"},"translation":{"en":{"bdb":"and the unstruck celestial sound current resounds. ||1||"}}},{"verseId":28389,"pageNo":656,"lineNo":11,"verse":{"unicode":"ਕੁੰਭ ਕਮਲੁ ਜਲਿ ਭਰਿਆ ॥"},"transliteration":{"english":"ku(n)bh kamal jal bhariaa ||"},"translation":{"en":{"bdb":"The pitcher of my heart-lotus is filled with water;"}}},{"verseId":28390,"pageNo":656,"lineNo":11,"verse":{"unicode":"ਜਲੁ ਮੇਟਿਆ ਊਭਾ ਕਰਿਆ ॥"},"transliteration":{"english":"jal meTiaa uoobhaa kariaa ||"},"translation":{"en":{"bdb":"I have spilled out the water, and set it upright."}}},{"verseId":28391,"pageNo":656,"lineNo":12,"verse":{"unicode":"ਕਹੁ ਕਬੀਰ ਜਨ ਜਾਨਿਆ ॥"},"transliteration":{"english":"kahu kabeer jan jaaniaa ||"},"translation":{"en":{"bdb":"Says Kabeer, the Lord's humble servant, this I know."}}},{"verseId":28392,"pageNo":656,"lineNo":12,"verse":{"unicode":"ਜਉ ਜਾਨਿਆ ਤਉ ਮਨੁ ਮਾਨਿਆ ॥੨॥੧੦॥"},"transliteration":{"english":"jau jaaniaa tau man maaniaa ||2||10||"},"translation":{"en":{"bdb":"Now that I know this, my mind is pleased and appeased. ||2||10||"}}}]}],"_archivedAt":"2026-11-07T22:34:51+00:00"}
